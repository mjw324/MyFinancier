# --- Database ---
# Local development: a local Postgres database (createdb finance_app_dev)
DATABASE_URL="postgres://[YOUR_USER]@localhost:5432/finance_app_dev"
DIRECT_URL="postgres://[YOUR_USER]@localhost:5432/finance_app_dev"
# Production (Supabase via Supavisor): pooled for runtime, direct for drizzle-kit
# DATABASE_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres.[YOUR_DATABASE]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Better Auth ---
BETTER_AUTH_SECRET="generate with: openssl rand -hex 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Plaid ---
PLAID_CLIENT_ID=""
PLAID_SANDBOX_SECRET=""
PLAID_PRODUCTION_SECRET=""
PLAID_ENV="sandbox"                                  # sandbox | production
PLAID_WEBHOOK_URL=""                                  # public URL only (e.g. ngrok); empty disables webhooks
PLAID_REDIRECT_URI=""                                 # only for OAuth institutions; must be registered in Plaid

# --- Encryption (AES-256-GCM key for Plaid access tokens) ---
# Must be a 32-byte hex string. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Amazon SES (transactional email) ---
AWS_SES_REGION="us-east-1"
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL="no-reply@my-financier.com"
SES_FROM_NAME="MyFinancier"
# Local development: print emails to the dev-server log instead of sending them
EMAIL_TRANSPORT="console"
